# Local Sahyfa dependency stack from docker-compose.sahyfa.dev.yml
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://sahyfa:sahyfa-dev-only@localhost:5433/sahyfa
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://localhost:6380/0

# MinIO uses the S3-compatible API on port 9002.
LEARNHOUSE_S3_ENDPOINT=http://localhost:9002
LEARNHOUSE_S3_ACCESS_KEY_ID=sahyfa
LEARNHOUSE_S3_SECRET_ACCESS_KEY=sahyfa-dev-only
